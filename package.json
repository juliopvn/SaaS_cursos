{
  "name": "saas-cursos",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de cursos online con roles admin y student",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "tsx --env-file-if-exists=.env.local scripts/init-storage.ts --quick || true",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "seed:reset": "tsx --env-file-if-exists=.env.local scripts/seed.ts --reset",
    "storage:init": "tsx --env-file-if-exists=.env.local scripts/init-storage.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "jose": "^6.2.12",
    "mongodb": "^7.6.0",
    "next": "~16.2.12",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.28.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "~16.2.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
