# =============================================================================
# SaaS de Cursos — variables de entorno
# Local:  cp .env.example .env.local   (nunca se versiona; solo este fichero)
# Prod:   se cargan en Vercel (Production). Los secretos NO van al repo.
# lib/env.ts valida todo con zod y aborta con un mensaje claro si falta algo.
# =============================================================================

# --- App ---------------------------------------------------------------------
# URL pública base; se usa para construir el magic link. Obligatoria.
# Prod: https://cursos.jpavon-tech.com
APP_URL=http://localhost:3000
# development | test | production (Next.js lo fija solo en dev/build/start).
NODE_ENV=development
# Opcional. "production" activa la validación estricta de lib/env.ts
# (Resend, https, secreto fuerte). En Vercel se deduce de VERCEL_ENV.
# APP_ENV=production

# --- MongoDB -----------------------------------------------------------------
# Obligatoria. Local: contenedor de docker-compose.
# Si el 27017 está ocupado: MONGO_PORT=27018 npm run infra:up  y usa el 27018 aquí.
# Prod: cadena SRV de Atlas (SECRETO).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=saas-cursos

# --- Auth / sesión -----------------------------------------------------------
# Obligatoria, mínimo 32 caracteres. Firma la cookie de sesión (jose, HS256).
# Prod: `openssl rand -base64 48` (SECRETO).
AUTH_SECRET=dev-only-secret-change-me-at-least-32-bytes-long
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=30
# El email que coincida recibe el rol admin al verificar su magic link.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin

# --- Email -------------------------------------------------------------------
# smtp (MailHog, local) | resend (producción)
MAIL_PROVIDER=smtp
# Prod: "Cursos <no-reply@jpavon-tech.com>"
MAIL_FROM="Cursos <no-reply@localhost>"
# MailHog: SMTP 1025, UI en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Solo prod, obligatoria con MAIL_PROVIDER=resend (SECRETO).
RESEND_API_KEY=

# --- Storage S3 (RustFS local / Cloudflare R2 prod) --------------------------
# Prod: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:9000
# Prod R2: auto
S3_REGION=us-east-1
S3_BUCKET=saas-cursos-files
# Local: credenciales por defecto de RustFS (ver docker-compose.yml). Prod: token R2 (SECRETO).
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
# Prod R2: false
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=10

# --- Tests E2E (solo local/CI) -----------------------------------------------
E2E_BASE_URL=http://localhost:3000
E2E_MONGODB_DB=saas-cursos-e2e
MAILHOG_API_URL=http://localhost:8025
